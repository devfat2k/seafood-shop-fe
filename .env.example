# ==============================================================================
# Seafood Shop Web — Environment Configuration
# ==============================================================================

# Application URL (Frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Endpoint (Java Spring Boot)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085

# Next.js Telemetry (0 = enabled, 1 = disabled)
NEXT_TELEMETRY_DISABLED=1

# Logging Level ('error' | 'info' | 'debug' | 'warning' | 'trace' | 'fatal')
NEXT_PUBLIC_LOGGING_LEVEL=info

# ------------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# ------------------------------------------------------------------------------
# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Tracking (Production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED=true

# Better Stack Log Ingestion
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=

# Arcjet Security Rate Limiting
ARCJET_KEY=
