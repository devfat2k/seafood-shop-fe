# ==============================================================================
# Seafood Shop Web — Production Environment (.env.prod)
# ==============================================================================

# Application URL (Frontend Vercel Domain)
NEXT_PUBLIC_APP_URL=https://seafood-shop-web.vercel.app

# Backend Java Spring Boot API (Render Production)
NEXT_PUBLIC_API_BASE_URL=https://java-mini-project-ecommerce.onrender.com

# Next.js Telemetry (0 = enabled, 1 = disabled)
NEXT_TELEMETRY_DISABLED=1

# Logging Level
NEXT_PUBLIC_LOGGING_LEVEL=info

# Node Environment
NODE_ENV=production
